+package auth
+
+import "database/sql"
+
+func Login(db *sql.DB, username, password string) bool {
+	query := "SELECT * FROM users WHERE username='" + username + "' AND password='" + password + "'"
+	row := db.QueryRow(query)
+	var id int
+	if err := row.Scan(&id); err != nil {
+		return false
+	}
+	return true
+}
