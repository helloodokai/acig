{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/helloodokai/acig/schema/verdict.schema.json",
  "$ref": "#/$defs/Verdict",
  "$defs": {
    "CriticResult": {
      "properties": {
        "critic": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "cost_usd": {
          "type": "number"
        },
        "duration_ms": {
          "type": "integer"
        },
        "tokens_in": {
          "type": "integer"
        },
        "tokens_out": {
          "type": "integer"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "critic",
        "model",
        "findings",
        "cost_usd",
        "duration_ms",
        "tokens_in",
        "tokens_out"
      ]
    },
    "Finding": {
      "properties": {
        "critic": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line_start": {
          "type": "integer"
        },
        "line_end": {
          "type": "integer"
        },
        "suggested_fix": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "critic",
        "severity",
        "title",
        "detail"
      ]
    },
    "Verdict": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "critic_results": {
          "items": {
            "$ref": "#/$defs/CriticResult"
          },
          "type": "array"
        },
        "total_cost_usd": {
          "type": "number"
        },
        "total_duration_ms": {
          "type": "integer"
        },
        "budget_remaining_usd": {
          "type": "number"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "repo",
        "sha",
        "base_sha",
        "risk",
        "decision",
        "summary",
        "findings",
        "critic_results",
        "total_cost_usd",
        "total_duration_ms",
        "budget_remaining_usd",
        "generated_at"
      ]
    }
  }
}
